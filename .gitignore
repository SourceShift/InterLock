# --- internal build apparatus (NOT part of the OSS SDK) ---
# The RSI harness references private lane scripts (~/ps/scripts/cl_*.sh) and
# internal strategy. The public repo is the interlock/ package plus tests/.
rsi/

# --- python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.venv/
venv/

# --- node / typescript (the R13 js/ tree; outside the wheel either way, since
# pyproject globs only "interlock*") ---
node_modules/
dist-test/
*.tsbuildinfo
# note: js/dist/ is already covered by the generic dist/ above

# --- rust (optional native accelerator) ---
rust/target/
# a locally built extension dropped on the import path for development
# (the canonical build is `cd rust && maturin develop`)
*.so

# --- os / editor ---
.DS_Store
*.swp

# --- mini-ork (vendored orchestrator, same category as rsi/ above) ---
# A working copy of the framework plus its run state, re-creatable with one
# rsync from /Volumes/docker-ssd/ps/mini-ork. Kept out of the tree so the
# public repo stays the interlock/ package plus tests/.
.mini-ork/
