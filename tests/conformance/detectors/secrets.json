[
  {
    "detector": "bearer_token_redactor",
    "factory": "bearer_token_redactor",
    "kwargs": {},
    "cases": [
      {
        "name": "masks a bearer token in a post body",
        "expect": "MODIFY",
        "event": {
          "action": "http_post",
          "args": {
            "body": "Forwarding credentials: {{bearer_header}}"
          }
        },
        "rewrite_includes": [
          "[REDACTED BEARER]"
        ],
        "rewrite_excludes": [
          "{{bearer_header}}"
        ]
      },
      {
        "name": "masks a bearer token logged as a message",
        "expect": "MODIFY",
        "event": {
          "action": "log",
          "args": {
            "message": "curl request used {{bearer_header}} to authenticate"
          }
        },
        "rewrite_includes": [
          "[REDACTED BEARER]"
        ],
        "rewrite_excludes": [
          "{{bearer_header}}"
        ]
      },
      {
        "name": "a bare Bearer scheme word with no token is not touched",
        "expect": "ALLOW",
        "event": {
          "action": "http_post",
          "args": {
            "body": "Set the Authorization scheme to Bearer and retry"
          }
        }
      },
      {
        "name": "a non-egress action is ignored",
        "expect": "ALLOW",
        "event": {
          "action": "read_file",
          "args": {
            "body": "{{bearer_header}}"
          }
        }
      },
      {
        "name": "the destination url key is left alone",
        "expect": "ALLOW",
        "event": {
          "action": "http_post",
          "args": {
            "url": "https://proxy.example/relay?auth={{bearer_header}}"
          }
        }
      }
    ]
  },
