  {
    "detector": "secret_entropy_egress_guard",
    "factory": "secret_entropy_egress_guard",
    "kwargs": {},
    "cases": [
      {
        "name": "blocks a high-entropy Stripe-shaped token in a post body",
        "expect": "BLOCK",
        "event": {
          "action": "http_post",
          "args": {
            "body": "upload key={{stripe_key}} now"
          }
        }
      },
      {
        "name": "blocks a high-entropy JWT relayed via fetch",
        "expect": "BLOCK",
        "event": {
          "action": "fetch",
          "args": {
            "data": "auth={{jwt}}"
          }
        }
      },
      {
        "name": "ordinary prose has no high-entropy token",
        "expect": "ALLOW",
        "event": {
          "action": "http_post",
          "args": {
            "body": "hello world this is just ordinary prose with no secrets at all today"
          }
        }
      },
      {
        "name": "a GitHub-shaped token sits below the default 4.0 bits/char threshold",
        "expect": "ALLOW",
        "event": {
          "action": "http_post",
          "args": {
            "body": "token={{gh_token}}"
          }
        }
      },
      {
        "name": "a non-egress action is ignored",
        "expect": "ALLOW",
        "event": {
          "action": "read_file",
          "args": {
            "body": "{{stripe_key}}"
          }
        }
      }
    ]
  },
  {
    "detector": "secret_entropy_egress_guard",
    "factory": "secret_entropy_egress_guard",
    "kwargs": {
      "min_len": 16,
      "threshold": 3.7
    },
    "cases": [
      {
        "name": "a lowered threshold now catches the GitHub-shaped token",
        "expect": "BLOCK",
        "event": {
          "action": "http_post",
          "args": {
            "body": "token={{gh_token}}"
          }
        }
      },
      {
        "name": "a lowered threshold now catches the AWS secret",
        "expect": "BLOCK",
        "event": {
          "action": "http_post",
          "args": {
            "body": "secret={{aws_secret}}"
          }
        }
      },
      {
        "name": "a hyphenated low-entropy identifier still passes",
        "expect": "ALLOW",
        "event": {
          "action": "http_post",
          "args": {
            "body": "the-quick-brown-fox-jumps-over-lazy-dog-again-and-again"
