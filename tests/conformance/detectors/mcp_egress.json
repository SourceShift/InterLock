        "event": {
          "action": "elicitation/create",
          "args": {}
        }
      }
    ]
  },
  {
    "detector": "mcp_surface_baseline",
    "factory": "mcp_surface_baseline",
    "kwargs": {},
    "cases": [
      {
        "name": "the first listing for a server is admitted as its baseline",
        "expect": "ALLOW",
        "event": {
          "action": "tools/list",
          "args": {
            "__origin__": "github",
            "__tools__": [
              {
                "name": "create_issue",
                "description": "Create a GitHub issue"
              }
            ]
          }
        }
      },
      {
        "name": "the same listing, keys re-serialized in a different order, is still the same fingerprint",
        "expect": "ALLOW",
        "event": {
          "action": "tools/list",
          "args": {
            "__tools__": [
              {
                "name": "create_issue",
                "description": "Create a GitHub issue"
              }
            ],
            "__origin__": "github"
          }
        }
      },
      {
        "name": "a later listing whose description changed is drift; the old baseline stands",
        "expect": "BLOCK",
        "event": {
          "action": "tools/list",
          "args": {
            "__origin__": "github",
            "__tools__": [
              {
                "name": "create_issue",
                "description": "Create a GitHub issue. NEW BEHAVIOR."
              }
            ]
          }
        }
      },
      {
        "name": "an unusable listing from an already-admitted server is refused, not ignored",
        "expect": "BLOCK",
        "event": {
          "action": "tools/list",
          "args": {
            "__origin__": "github",
            "__tools__": "oops-not-a-list"
          }
        }
      },
      {
        "name": "a different server's first listing is admitted independently",
        "expect": "ALLOW",
        "event": {
          "action": "tools/list",
          "args": {
            "__origin__": "slack",
            "__tools__": [
              {
                "name": "post_message",
                "description": "Post a message"
              }
            ]
          }
        }
      },
      {
        "name": "a listing with no server label is out of scope",
        "expect": "ALLOW",
        "event": {
          "action": "tools/list",
          "args": {
            "__tools__": [
              {
                "name": "create_issue",
                "description": "Create a GitHub issue"
              }
            ]
          }
        }
      },
      {
        "name": "a tool call (not a listing) is out of scope for this rule",
        "expect": "ALLOW",
        "event": {
          "action": "github.create_issue",
          "args": {
            "__schema__": "x"
          }
        }
      }
    ]
  },
