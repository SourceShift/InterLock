  {
    "detector": "data_egress",
    "factory": "pii_redaction_guard",
    "kwargs": {},
    "cases": [
      {
        "name": "an email address in the outbound body is masked, not blocked",
        "expect": "MODIFY",
        "event": {
          "action": "http_post",
          "args": {
            "body": "Contact me at {{email}} for details"
          }
        },
        "rewrite_includes": [
          "[REDACTED EMAIL]"
        ],
        "rewrite_excludes": [
          "{{email}}"
        ]
      },
      {
        "name": "a card number in an outbound email body is masked",
        "expect": "MODIFY",
        "event": {
          "action": "send_email",
          "args": {
            "body": "card: {{credit_card}}"
          }
        },
        "rewrite_includes": [
          "[REDACTED CREDIT_CARD]"
        ],
        "rewrite_excludes": [
          "{{credit_card}}"
        ]
      },
      {
        "name": "a clean outbound payload is untouched",
        "expect": "ALLOW",
        "event": {
          "action": "http_post",
          "args": {
            "body": "no secrets here, just a normal update"
          }
        }
      },
      {
        "name": "a non-egress action is out of scope even carrying a secret",
        "expect": "ALLOW",
        "event": {
          "action": "read_file",
          "args": {
            "body": "{{aws_secret}}"
          }
        }
      }
    ]
  },
  {
    "detector": "data_egress",
    "factory": "sensitive_path_guard",
    "kwargs": {},
    "cases": [
      {
        "name": "reading /etc/passwd is denied",
