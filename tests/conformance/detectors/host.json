          }
        }
      },
      {
        "name": "namespace outside the allowed options is blocked",
        "expect": "BLOCK",
        "event": {
          "action": "Bash",
          "args": {
            "command": "kubectl rollout restart deployment/payments-api -n production"
          }
        }
      },
      {
        "name": "deployment name failing its pattern is blocked",
        "expect": "BLOCK",
        "event": {
          "action": "Bash",
          "args": {
            "command": "kubectl rollout restart deployment/PaymentsAPI -n prod"
          }
        }
      },
      {
        "name": "a chained command is not a single plain command",
        "expect": "BLOCK",
        "event": {
          "action": "Bash",
          "args": {
            "command": "kubectl rollout restart deployment/payments-api -n prod && rm -rf /"
          }
        }
      },
      {
        "name": "tail line count over the param max is blocked",
        "expect": "BLOCK",
        "event": {
          "action": "Bash",
          "args": {
            "command": "kubectl logs payments-api --tail=5000"
          }
        }
      },
      {
        "name": "a valid restart-deployment call is allowed",
        "expect": "ALLOW",
        "event": {
          "action": "Bash",
          "args": {
            "command": "kubectl rollout restart deployment/payments-api -n prod"
          }
        }
      },
      {
        "name": "the same runbook via the 'cmd' key is allowed too",
        "expect": "ALLOW",
        "event": {
          "action": "Bash",
          "args": {
            "cmd": "kubectl rollout restart deployment/web-app-7 -n staging"
          }
        }
      },
      {
        "name": "a valid tail-logs call is allowed",
        "expect": "ALLOW",
        "event": {
          "action": "Bash",
          "args": {
            "command": "kubectl logs payments-api --tail=100"
          }
        }
      }
    ]
  },
