        "event": {
          "action": "run_shell",
          "args": {
            "command": "dd if=/dev/zero of=output.img bs=1M count=10"
          }
        }
      },
      {
        "name": "rm -rf of a relative build dir is allowed",
        "expect": "ALLOW",
        "event": {
          "action": "run_shell",
          "args": {
            "command": "rm -rf ./build"
          }
        }
      },
      {
        "name": "rm -rf of a scratch subdirectory under /tmp is allowed",
        "expect": "ALLOW",
        "event": {
          "action": "run_shell",
          "args": {
            "command": "rm -rf /tmp/scratch-xyz"
          }
        }
      },
      {
        "name": "chmod -R 755 of a relative dist dir is allowed",
        "expect": "ALLOW",
        "event": {
          "action": "run_shell",
          "args": {
            "command": "chmod -R 755 ./dist"
          }
        }
      },
      {
        "name": "find -delete on a relative path is allowed",
        "expect": "ALLOW",
        "event": {
          "action": "run_shell",
          "args": {
            "command": "find . -name '*.tmp' -delete"
          }
        }
      },
      {
        "name": "an unclosed quote hiding the delete is asked about, not allowed",
