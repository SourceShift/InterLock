    "kwargs": {
      "block": [
        "drop",
        "truncate",
        "unbounded",
        "external"
      ],
      "escalate": [
        "delete",
        "grant"
      ]
    },
    "cases": [
      {
        "name": "DROP TABLE",
        "expect": "BLOCK",
