        "event": {
          "action": "run_shell",
          "args": {
            "command": "rm -fr /"
          }
        }
      },
      {
        "name": "/bin/rm -Rf / (absolute binary path, capitalised flag)",
        "expect": "BLOCK",
        "event": {
          "action": "run_shell",
          "args": {
            "command": "/bin/rm -Rf /"
          }
        }
      },
      {
        "name": "sudo-wrapped rm -rf / is still parsed through",
        "expect": "BLOCK",
        "event": {
          "action": "run_shell",
          "args": {
            "command": "sudo bash -c 'rm -rf /'"
          }
        }
      },
      {
        "name": "chmod -R 777 / matches the raw pattern directly",
        "expect": "BLOCK",
        "event": {
          "action": "run_shell",
          "args": {
            "command": "chmod -R 777 /"
          }
        }
      },
      {
        "name": "mkfs on a block device",
        "expect": "BLOCK",
        "event": {
          "action": "run_shell",
          "args": {
            "command": "mkfs.ext4 /dev/sdb1"
          }
        }
      },
      {
        "name": "fork bomb",
        "expect": "BLOCK",
        "event": {
          "action": "run_shell",
          "args": {
            "command": ":(){ :|:& };:"
          }
        }
      },
      {
        "name": "redirect onto a raw disk device",
        "expect": "BLOCK",
        "event": {
          "action": "run_shell",
          "args": {
            "command": "cat payload.bin > /dev/sda"
          }
        }
      },
      {
        "name": "disk-dump tool onto a plain image file is not a disk write",
