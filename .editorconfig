# Keep editors from disagreeing about the boring parts. Python is 4 spaces,
# everything else is 2, and every text file ends with one newline.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4

[Makefile]
indent_style = tab

[*.md]
# Markdown uses two trailing spaces for a hard line break.
trim_trailing_whitespace = false
