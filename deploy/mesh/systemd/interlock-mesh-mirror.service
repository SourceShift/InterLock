[Unit]
Description=Interlock mesh commons mirror
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=interlock-mesh
Group=interlock-mesh
WorkingDirectory=/srv/interlock-mesh
ExecStart=/srv/interlock-mesh/bin/mirror.sh
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/interlock-mesh

[Install]
WantedBy=multi-user.target
