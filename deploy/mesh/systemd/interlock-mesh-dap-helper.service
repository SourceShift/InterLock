[Unit]
Description=Interlock mesh DAP helper (test pair only)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=interlock-mesh
Group=interlock-mesh
WorkingDirectory=/srv/interlock-mesh
ExecStart=/srv/interlock-mesh/venv/bin/interlock mesh serve --role dap-helper --task /srv/interlock-mesh/dap/task.json --keys /srv/interlock-mesh/dap/helper.json --bind 127.0.0.1:7961 --state /srv/interlock-mesh/state/dap-helper.json
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/interlock-mesh

[Install]
WantedBy=multi-user.target
