# Copy to deploy/cloud/.env and fill in per deployment.
#
# This file holds placeholders only: no key material, no generated secret, no
# value that looks like a real credential. There is nothing here worth
# committing, and nothing here is needed to run the development stack.

# -- host paths to the secret files -------------------------------------
# Relative to deploy/cloud/. Create each with mode 0600; see secrets/README.md.
IL_CLOUD_DB_PASSWORD_FILE=./secrets/postgres-password
IL_CLOUD_SESSION_SECRET_FILE_PATH=./secrets/session-secret
IL_CLOUD_APPROVAL_KEY_FILE_PATH=./secrets/approval-key
IL_CLOUD_POLICY_KEY_FILE_PATH=./secrets/policy-key
IL_CLOUD_PREVIEW_KEK_FILE_PATH=./secrets/preview-kek
IL_CLOUD_OIDC_CLIENT_SECRET_FILE_PATH=./secrets/oidc-client-secret

# -- plane URL -----------------------------------------------------------
# The public https URL Caddy terminates, e.g. https://cloud.example.com.
IL_CLOUD_PUBLIC_URL=https://cloud.example.com

# -- OIDC (optional) -----------------------------------------------------
IL_CLOUD_OIDC_ISSUER=
IL_CLOUD_OIDC_CLIENT_ID=
IL_CLOUD_OIDC_REDIRECT_URI=
IL_CLOUD_OIDC_ORG_SLUG=

# -- TLS profile ---------------------------------------------------------
IL_CLOUD_HOSTNAME=cloud.example.com
IL_CLOUD_ACME_EMAIL=

# -- logging -------------------------------------------------------------
IL_CLOUD_LOG_LEVEL=info
