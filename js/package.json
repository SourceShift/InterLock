{
  "name": "interlock-guard",
  "version": "0.0.1",
  "description": "Guard a Node.js agent's MCP tool calls with the same policy engine the Python interlock SDK uses. The JS side enforces; a Python sidecar decides.",
  "license": "Apache-2.0",
  "author": "Amir Khakshour",
  "type": "module",
  "engines": {
    "node": ">=20.6"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./wire": {
      "types": "./dist/wire.d.ts",
      "default": "./dist/wire.js"
    },
    "./mcp": {
      "types": "./dist/mcp.d.ts",
      "default": "./dist/mcp.js"
    },
    "./esm": {
      "types": "./dist/esm.d.ts",
      "default": "./dist/esm.js"
    },
    "./esm-hook": {
      "types": "./dist/esm-hook.d.ts",
      "default": "./dist/esm-hook.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/test/*.test.js",
    "bench": "node bench/roundtrip.mjs",
    "clean": "rm -rf dist dist-test *.tsbuildinfo"
  },
  "keywords": [
    "ai",
    "agents",
    "guardrails",
    "mcp",
    "security",
    "runtime",
    "policy"
  ],
  "dependencies": {},
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  }
}
